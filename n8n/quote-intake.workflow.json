              "value": "={{ ($json.priority === 'urgent' ? 'URGENT: ' : '') + 'Quote request ' + $json.id + ' from ' + $json.from + ' (' + $json.subject + ')' + ($json.status === 'error' ? ' is in the ERROR QUEUE: ' + $json.errorReason : ($json.needsReview ? ' needs review: ' + $json.reviewReasons.join('; ') : ' is waiting for approval.')) + ' Open http://127.0.0.1:3000' + $json.url }}",
              "type": "string"
            }
