      },
      "id": "bfe23945-fb04-5729-aa00-75ab6732e2dd",
      "name": "Test email (webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        320
      ],
      "webhookId": "3f5d2a64-1c1e-4a55-9a0e-6b1f0e7c2a10"
    },
    {
      "parameters": {
        "jsCode": "// Turns an incoming email (IMAP trigger or test webhook) into the format\n// the quote engine expects: { messageId, from, subject, receivedAt, body }.\n// No business logic here: reading, pricing and review rules live in the engine.\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  // Test webhook: the email is in the request body. IMAP: it is the item itself.\n  const src = j.body && typeof j.body === 'object' ? j.body : j;\n\n  const f = src.from;\n  const from = typeof f === 'string' ? f : (f?.value?.[0]?.address ?? f?.text ?? '');\n  const html = src.html ?? src.textHtml ?? '';\n  const text = src.text ?? src.textPlain ?? (typeof src.body === 'string' ? src.body : '') ?? '';\n  const body = String(text || html.replace(/<[^>]+>/g, ' ')).trim();\n\n  const parsed = new Date(src.receivedAt ?? src.date ?? Date.now());\n  const receivedAt = isNaN(parsed.getTime()) ? new Date().toISOString() : parsed.toISOString();\n  const subject = String(src.subject ?? '');\n\n  // The Message-ID makes the engine call safe to repeat (no duplicate request,\n  // no second AI charge). If an email has none, use a stable stand-in.\n  const messageId = src.messageId ?? src.metadata?.['message-id'] ?? `<${from}|${receivedAt}|${subject}>`;\n\n  out.push({ json: { messageId, from, subject, receivedAt, body } });\n}\nreturn out;"
      },
      "id": "78553876-7ece-510d-a794-59c25ed86477",
      "name": "Normalize email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
